<?xml version="1.0" encoding="utf-8"?>
<!-- Padding leaves room for the elevation shadow -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/overlay_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="14dp"
        android:elevation="6dp"
        android:background="@drawable/overlay_bubble_bg"
        android:src="@drawable/ic_mic_48dp"
        android:tint="@color/overlayCream"
        android:contentDescription="@string/overlay_bubble_description" />
</FrameLayout>
